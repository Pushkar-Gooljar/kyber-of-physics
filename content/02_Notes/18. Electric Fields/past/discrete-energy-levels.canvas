{
	"nodes":[
		{"id":"a9ffe48144edb894","type":"text","text":"Electrons emit photons when transitioning between energy levels","x":140,"y":-160,"width":326,"height":93},
		{"id":"71893ae12bbca69a","type":"text","text":"Photon energy is equal to difference between energy levels ($\\Delta E=hf$)","x":500,"y":-160,"width":326,"height":93},
		{"id":"541bdab07434fc37","type":"text","text":"Photon energy is related to frequency","x":860,"y":-160,"width":326,"height":93},
		{"id":"5cbe111220068d0f","type":"text","text":"Discrete frequencies on spectrum mean that photon energies are discrete.","x":860,"y":-20,"width":326,"height":93},
		{"id":"cc787cab9393fdd2","type":"text","text":"electrons emit photons when transitioning between energy levels. photon energy is equal to difference in energy of energy levels. photon energy is related to frequency. since spectrum has discrete frequencies, photon energies must be discrete. therefore, difference in electron energy levels and the energy levels themselves must be discret.","x":500,"y":-20,"width":326,"height":93},
		{"id":"45cf1c6e515c03c6","type":"text","text":"Therefore electron energy levels must be discrete.","x":140,"y":-20,"width":326,"height":93}
	],
